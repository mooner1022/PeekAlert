<?xml version="1.0" encoding="utf-8"?>
<!-- Inflated into PeekAlertView, which is the ConstraintLayout these constraints refer to. -->
<merge
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    tools:parentTag="androidx.constraintlayout.widget.ConstraintLayout">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_background"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:cardElevation="0dp"
        app:cardMaxElevation="0dp"
        app:cardCornerRadius="@dimen/peeker_radius_default">

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:layout_weight="1">

                <ImageView
                    tools:tint="#000000"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/icon"
                    android:padding="@dimen/peeker_padding_default"
                    app:srcCompat="@drawable/round_info_24"/>

                <!-- As tall as its lines, so the card grows with a long text: with match_parent the row's
                     height came from the icon alone and a third line was cut off.
                     The text fills each line before it starts the next. Left to even its lines out, it broke a
                     word too long for a line (an exception's class name) in its middle and took a line more,
                     with half the card's width left empty. -->
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:paddingVertical="8dp"
                    android:layout_marginEnd="8dp">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:id="@+id/title"
                        android:layout_marginEnd="@dimen/peeker_padding_default"
                        android:textSize="15sp"
                        android:visibility="gone"
                        android:textStyle="bold"
                        android:ellipsize="end"
                        android:maxLines="1"
                        tools:text="TITLE"/>
                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:id="@+id/content"
                        android:layout_marginEnd="@dimen/peeker_padding_default"
                        android:textSize="15sp"
                        android:ellipsize="end"
                        android:breakStrategy="simple"
                        android:hyphenationFrequency="none"
                        android:maxLines="@integer/peeker_text_max_lines"
                        tools:text="CONTENT"/>
                </LinearLayout>

            </LinearLayout>

            <androidx.cardview.widget.CardView
                android:id="@+id/card_action"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/peeker_padding_default"
                android:layout_gravity="center_vertical|end"
                android:layout_weight="0"
                app:cardElevation="0dp"
                app:cardCornerRadius="14dp">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/action_text"
                    android:textSize="13sp"
                    android:textStyle="bold"
                    android:layout_marginHorizontal="12dp"
                    android:layout_marginVertical="6dp"
                    tools:text="Action"/>

            </androidx.cardview.widget.CardView>

        </LinearLayout>

    </androidx.cardview.widget.CardView>
</merge>
